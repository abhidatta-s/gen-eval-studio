# Copy the value you need into your shell. This project reads environment
# variables directly (os.environ), so no python-dotenv is needed:
#   export HF_TOKEN=hf_your_token_here
#
# Only needed for the "hf" generator. Create a free token at
# https://huggingface.co/settings/tokens (a read token is enough).
# The default "mock" generator needs no keys at all.
# Never commit a real token. The .env file is listed in .gitignore.
HF_TOKEN=
